    },
    {
      "source": "/Experience/GoogleSummerOfCode.sol",
      "destination": "/experience/gsoc-aossie.md",
      "permanent": false
    },
    {
      "source": "/Projects/TakeYourQuiz.js",
      "destination": "/archive/takeyourquiz/README.md",
